# VAS configuration. Everything here is optional.
#
# Bridge settings are read from the environment when the bridge starts
# (set them in PowerShell with $env:NAME = 'value', or let the VAS app pass them).
# Frontend settings (VITE_*) are read by Vite at build/dev time from .env.local.
# Copy this file to .env.local for the VITE_* values; never commit real keys.

# --- Bridge (JARVIS's brain) ---
# JARVIS_MODEL=claude-opus-5
# JARVIS_EFFORT=medium
# JARVIS_BRIDGE_PORT=8787
# JARVIS_ALLOWED_ORIGINS=
# JARVIS_FILE_ROOTS=
# JARVIS_VOICE_ID=
# JARVIS_DEBUG=0
# ELEVENLABS_API_KEY=        # optional: better voice and Scribe transcription

# --- Frontend (JARVIS's face) ---
# VITE_BACKEND=bridge
# VITE_BRIDGE_URL=ws://127.0.0.1:8787
# VITE_TTS_ENGINE=system     # system | kokoro
# VITE_KOKORO_VOICE=
# VITE_USE_ELEVENLABS=false
