{
  "name": "vas",
  "productName": "VAS",
  "private": true,
  "version": "0.1.0",
  "description": "VAS: a Windows desktop app for JARVIS, a voice assistant whose brain is Claude Code.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "web": "node scripts/start.mjs",
    "dev": "node scripts/dev-app.mjs",
    "dev:web": "vite",
    "app": "npm run build && electron .",
    "prebuild": "node scripts/vendor-wasm.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs --insecure-dev",
    "bridge:writes": "node bridge/server.mjs --writes --insecure-dev",
    "setup": "node scripts/setup.mjs",
    "probe:chrome": "node scripts/probe-chrome.mjs",
    "models": "node scripts/fetch-models.mjs",
    "test": "node --test \"test/bridge/*.test.mjs\" && node --import tsx --test \"test/renderer/*.test.ts\"",
    "probe:voice": "node scripts/probe-voice.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir",
    "e2e:app": "node scripts/e2e-app.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "sherpa-onnx-node": "1.13.8",
    "ws": "^8.21.1",
    "yaml": "2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "dompurify": "^3.4.12",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "zustand": "^5.0.14"
  },
  "author": "Aswin",
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.aswin.vas",
    "productName": "VAS",
    "copyright": "Copyright © 2026 Aswin",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "dist/**",
      "electron/**",
      "bridge/**",
      "config/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "executableName": "VAS"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VAS",
      "artifactName": "VAS Setup ${version}.${ext}",
      "runAfterFinish": true
    }
  }
}
