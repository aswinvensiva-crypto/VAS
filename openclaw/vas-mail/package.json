{
  "name": "vas-mail",
  "version": "0.1.0",
  "private": true,
  "description": "Gmail send, list and read for VAS, as an OpenClaw tool plugin",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run plugin:build && openclaw plugins validate --entry ./dist/index.js",
    "test": "npm run build && node --test test/"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "dependencies": {
    "imapflow": "2.2.5",
    "mailauth": "7.1.1",
    "mailparser": "3.9.36",
    "nodemailer": "7.0.13",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "7.0.12",
    "openclaw": "2026.10.5",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  }
}
